# .env.local — persistent local developer overrides
#
# Copy this file to .env.local and set values for your local environment.
# .env.local is gitignored and auto-loaded by every make target via bootstrap.sh.
# Shell environment variables always take precedence over values set here.

# Override the ArgoCD Application targetRevision for local feature-branch development.
# When unset, defaults to the current git branch (git branch --show-current).
# Has no effect on STACKIT profiles.
# ARGOCD_LOCAL_TARGET_REVISION=my-feature-branch

# Override the local Kubernetes context (defaults to docker-desktop).
# LOCAL_KUBE_CONTEXT=kind-kind

# Override managed service credentials for local development.
# MANAGED_CACHE_PASSWORD=my-local-redis-password
# POSTGRES_MASTER_USER_PASSWORD=my-local-pg-password
