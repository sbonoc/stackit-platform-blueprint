export QUALITY_HOOKS_KEEP_GOING=true

# Cross-reference the canonical Python version from versions.sh so pyenv
# resolves the correct interpreter without a separate .python-version file.
# shellcheck source=scripts/lib/platform/apps/versions.sh
source scripts/lib/platform/apps/versions.sh
export PYENV_VERSION="${PYTHON_RUNTIME_BASE_IMAGE_VERSION}"

# Activate the uv-managed virtual environment when present.
# Run 'make python-env-setup' once after cloning to create it.
if [[ -d .venv ]]; then
  source .venv/bin/activate
fi
